{
  "name": "relocation-options-dashboard",
  "version": "0.1.0",
  "description": "Open-source, local-first relocation and job-offer comparison studio.",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/ylnhari/relocation-options-dashboard.git"
  },
  "homepage": "https://github.com/ylnhari/relocation-options-dashboard#readme",
  "bugs": {
    "url": "https://github.com/ylnhari/relocation-options-dashboard/issues"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "typecheck": "tsc --noEmit",
    "generate:schema-validator": "node scripts/generate-schema-validator.mjs",
    "check:schema-validator": "node scripts/check-schema-validator.mjs",
    "validate:data": "node scripts/validate-data.mjs",
    "validate:examples": "npm run check:schema-validator && node scripts/validate-data.mjs examples/wayfinder.example.json && node scripts/validate-data.mjs examples/wayfinder.template.json",
    "test": "npm run typecheck && npm run build && node --test tests/document.test.mjs tests/import-validator.test.mjs tests/validate-data.test.mjs tests/rendered-html.test.mjs tests/calculations.test.mjs tests/share-report.test.mjs && python -m unittest tests/test_portlib.py",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "check": "npm run validate:examples && npm test && npm run lint"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.52.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.5",
    "@vitejs/plugin-rsc": "0.5.34",
    "ajv": "8.20.0",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.6",
    "vite": "8.2.1",
    "wrangler": "4.123.0"
  },
  "type": "module"
}
